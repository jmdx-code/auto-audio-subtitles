{
  "manifest_version": 3,
  "name": "自动音频字幕",
  "description": "使用 Edge TTS 批量生成音频并创建连续时间轴 SRT 字幕。",
  "version": "0.1.6",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "打开自动音频字幕",
    "default_popup": "launcher.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://speech.platform.bing.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  }
}
